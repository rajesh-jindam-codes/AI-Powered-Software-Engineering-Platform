# ==========================================
# DEVFLOW AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real credentials!
# ==========================================

# Core Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Security & Multi-Tenant JWT
JWT_SECRET=devflow_super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=devflow_super_secret_refresh_key_replace_in_production
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# PostgreSQL Database & pgvector
DATABASE_URL=postgresql://devflow:devflow_secure_password@localhost:5432/devflow_db?schema=public
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secure_password
POSTGRES_DB=devflow_db
POSTGRES_PORT=5432

# Redis Cache, Locks & Presence
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PRESENCE_TTL=60

# Apache Kafka Distributed Job Processing
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=devflow-api
KAFKA_GROUP_ID=devflow-workers-group
KAFKA_RETRY_MAX_ATTEMPTS=3

# GitHub OAuth & Webhooks
GITHUB_CLIENT_ID=gh_client_id_placeholder
GITHUB_CLIENT_SECRET=gh_client_secret_placeholder
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=gh_webhook_secret_hmac_key_min_32_chars

# AI Engine Service (Python FastAPI & LLM Providers)
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=sk-placeholder_openai_api_key
ANTHROPIC_API_KEY=sk-ant-placeholder_anthropic_key
GEMINI_API_KEY=AIzaSy_placeholder_gemini_key

# Observability, Prometheus & OpenTelemetry
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=devflow-monolith
LOG_LEVEL=info
